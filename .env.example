# Your Shopify store. Products, collections, cart and checkout all come from here.
SHOPIFY_STORE_DOMAIN=opgreen.myshopify.com

# Optional. Leave blank to use Shopify's tokenless Storefront access
# (products, collections and cart work without a key).
SHOPIFY_STOREFRONT_TOKEN=

SHOPIFY_API_VERSION=2025-07

# 1 = tell search engines not to index this site yet, so it doesn't compete
# with the Shopify store while both are live. Set to 0 at cutover.
NEXT_PUBLIC_NOINDEX=1

# Testing only: 1 = use the built-in sample catalog instead of Shopify.
SHOPIFY_MOCK=0
